# ── 应用 ──
APP_NAME=Smart Home API
DEVELOPMENT_MODE=true

# ── 数据库 ──
DATABASE_URL=sqlite:///./db/orion_home.db

# 开发环境使用 sqlite；生产环境改为 postgres，并配置独立 PostgreSQL 地址
CHECKPOINTER_TYPE=sqlite
CHECKPOINTER_DATABASE_URL=
PRODUCTION_MODE=false

# ── 身份认证 ──
JWT_SECRET_KEY=change-this-to-a-random-secret
# 生产环境必须与 JWT 密钥分离，且不可在轮换 JWT 时一并更改
API_KEY_ENCRYPTION_SECRET=
ACCESS_TOKEN_EXPIRE_SECONDS=3600
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# ── 跨域资源共享 ──
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ── 文件上传 ──
UPLOAD_DIR=app/uploads
MAX_AVATAR_SIZE=2097152
ALLOWED_AVATAR_TYPES=["image/jpeg","image/png","image/webp"]
MAX_DEVICE_IMAGE_SIZE=5242880
ALLOWED_DEVICE_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# ── Agent ──
AGENT_RATE_LIMIT_PER_MINUTE=10
AGENT_DAILY_BUDGET_TOKENS=500000
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
# ── 上下文压缩 / 会话树 ──
# 是否启用自动上下文压缩（阈值触发）
COMPACTION_ENABLED=true
# 为 LLM 回复预留的 token 数，决定压缩触发阈值与摘要响应预算
COMPACTION_RESERVE_TOKENS=16384
# 最近保留（不被摘要）的 token 数，决定切割点
COMPACTION_KEEP_RECENT_TOKENS=20000
# 分支摘要请求的响应预算上限
COMPACTION_BRANCH_SUMMARY_MAX_TOKENS=2048
# 摘要前工具结果的最大保留字符数（超长截断）
COMPACTION_TOOL_RESULT_MAX_CHARS=2000
# 摘要请求瞬时错误的重试次数
COMPACTION_RETRY_ATTEMPTS=0
# 摘要响应的模型完成 token 上限（可选，留空/注释表示不设上限）
# COMPACTION_MAX_TOKENS=8192
# 会话树/压缩触发时使用的默认上下文窗口（模型未配置 context_window 时兜底）
SESSION_TREE_CONTEXT_WINDOW=200000
