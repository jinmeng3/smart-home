[
  {
    "label": "FastAPI Debug",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "uvicorn",
    "cwd": "$ZED_WORKTREE_ROOT/smarthome-api",
    "args": [
      "app.main:app",
      "--host",
      "127.0.0.1",
      "--port",
      "8000",
      "--reload",
      "--reload-dir",
      "$ZED_WORKTREE_ROOT/smarthome-api",
    ],
    "env": {
      "PYTHONPATH": "$ZED_WORKTREE_ROOT/smarthome-api",
    },
    "justMyCode": true,
  },
  {
    "adapter": "Debugpy",
    "label": "run '…ervices\\chat.py'",
    "request": "launch",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "args": [],
    "cwd": "$ZED_WORKTREE_ROOT",
    "program": "\"$ZED_FILE\""
  },
]
